<Project Sdk="Microsoft.NET.Sdk">

  <!-- Configurações de build, segurança e metadados comuns: ..\Directory.Build.props -->

  <PropertyGroup>
    <RootNamespace>TEC.Observability</RootNamespace>
    <Description>Deixa cada serviço observável do mesmo jeito: rastreia requisições, coleta métricas e logs, correlaciona chamadas entre serviços e informa a saúde do serviço e das dependências, com o destino da telemetria escolhido por configuração.</Description>
    <PackageTags>observability;opentelemetry;healthchecks;tracing;metrics;logging;otlp;aot;tec</PackageTags>
    <!-- Analisadores de trimming e Native AOT no build: qualquer IL2xxx/IL3xxx do código da biblioteca aparece aqui. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Binding de configuração gerado em tempo de compilação (sem reflexão: compatível com trimming e Native AOT). -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <!-- ASP.NET Core (health checks, endpoints, IHttpClientFactory) vem do shared framework, não de pacotes. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- Só OpenTelemetry (OTLP e console): o Azure Monitor fica no pacote TEC.Observability.Azure. -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

  <!-- Testes do pacote Azure (projeto separado, fora da convenção $(TecComponent).Tests) exercitam peças internas dos dois pacotes -->
  <ItemGroup>
    <InternalsVisibleTo Include="TEC.Observability.Azure.Tests" />
  </ItemGroup>

</Project>
